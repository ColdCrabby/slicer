{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cold Crabby Desktop",
  "version": "0.1.0",
  "identifier": "com.maxscopp.slicerengine",
  "build": {
    "beforeDevCommand": "pnpm --filter slicer-ui start",
    "devUrl": "http://localhost:4213",
    "beforeBuildCommand": "pnpm --filter slicer-ui build",
    "frontendDist": "../../ui/dist/slicer-ui/browser"
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**", "$APPDATA/**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Cold Crabby",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 13 },
        "dragDropEnabled": false
      }
    ]
  }
}
