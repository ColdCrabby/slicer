{
  "name": "slicer-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/vendor-ui.mjs",
    "vendor:ui": "node scripts/vendor-ui.mjs",
    "start": "ng serve --host 0.0.0.0",
    "start:web-slicer": "ng serve --host 0.0.0.0 --configuration web-slicer",
    "build": "ng build",
    "build:web-slicer": "ng build --configuration web-slicer",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "gen-schemas": "cd .. && cargo run -- gen-schemas --output-dir ui/src/schemas",
    "gen-types": "pnpm exec json2ts --declareExternallyReferenced -i \"src/schemas/*.json\" -o src/generated",
    "gen-catalog-client": "pnpm exec openapi-ts",
    "gen": "pnpm run gen-schemas && pnpm run gen-types && pnpm run gen-catalog-client"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/aria": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/utils": "^0.2.12",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@types/three": "^0.185.0",
    "fuse.js": "^7.5.0",
    "iconoir": "^7.12.1",
    "katex": "^0.18.6",
    "marked": "^18.0.11",
    "marked-katex-extension": "^5.1.12",
    "monaco-editor": "^0.56.0",
    "ngx-markdown": "^22.0.2",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tinykeys": "^4.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@hey-api/openapi-ts": "^0.99.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0",
    "zone.js": "~0.16.3"
  }
}
